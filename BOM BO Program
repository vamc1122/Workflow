begin_method restore_data changing container.

DATA: it_mast     TYPE TABLE OF mast,
      wa_mast     TYPE mast,
      wa_old_data TYPE zcs02,
      it_stpo     TYPE TABLE OF  stpo,
      wa_stpo     TYPE stpo,
      it_stko     TYPE TABLE OF stko,
      wa_stko     TYPE stko,
      wa_cs02     TYPE zcs02.


DATA:change_no LIKE rc29k-aennr.

swc_get_element container 'CHANGE_NO' change_no.

SELECT SINGLE * FROM mast INTO wa_mast WHERE
    matnr = object-key-material
AND werks = object-key-plant
AND stlan = object-key-bomusage.

SELECT * FROM stpo INTO TABLE it_stpo WHERE
         stlnr = wa_mast-stlnr
         AND aennr = change_no.

LOOP AT it_stpo INTO wa_stpo.
  SELECT SINGLE * FROM zcs02 INTO wa_cs02
   WHERE  stlty = wa_stpo-stlty
    AND stlnr = wa_stpo-stlnr
    AND stlkn = wa_stpo-stlkn
    AND stpoz = wa_stpo-stpoz.
  IF sy-subrc = 0.
    UPDATE stpo SET menge = wa_cs02-menge
      WHERE stlty = wa_stpo-stlty
      AND stlnr = wa_stpo-stlnr
      AND stlkn = wa_stpo-stlkn
      AND stpoz = wa_stpo-stpoz.
  ELSE.
    MODIFY stpo FROM wa_stpo.
  ENDIF.


  SELECT SINGLE * FROM zcs02 INTO wa_cs02
   WHERE  stlty = wa_stpo-stlty
    AND stlnr = wa_stpo-stlnr
    AND stlkn = wa_stpo-stlkn
    AND stpoz = wa_stpo-stpoz
    AND vbkz = 'I'.
  IF sy-subrc = 0.
    DELETE FROM stpo
      WHERE stlty = wa_stpo-stlty
      AND stlnr = wa_stpo-stlnr
      AND stlkn = wa_stpo-stlkn
      AND stpoz = wa_stpo-stpoz.
  ENDIF.
ENDLOOP.


SELECT SINGLE * FROM zcs02 INTO wa_old_data
 WHERE stlnr = wa_mast-stlnr.
IF sy-subrc = 0.
  IF wa_old_data-bmenge_old > 1.
    UPDATE stko SET bmeng = wa_old_data-bmenge_old
      WHERE stlnr = wa_stpo-stlnr.
  ENDIF.
ENDIF.

end_method.


