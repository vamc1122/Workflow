begin_method get_agents changing container.
DATA:
  agent01     LIKE swhactor OCCURS 0,
  agent02     LIKE swhactor OCCURS 0,
  email1      TYPE soxna-fullname OCCURS 0,
  email2      TYPE soxna-fullname OCCURS 0,
  email_init  TYPE soxna-fullname,
  email_final TYPE soxna-fullname OCCURS 0,
  wemail      TYPE soxna-fullname,

  itab        TYPE TABLE OF zbom_user,
  wtab        TYPE zbom_user,
  ls_appr     LIKE swhactor.
DATA : w_user TYPE bapibname-bapibname.
DATA: lit_return  TYPE STANDARD TABLE OF bapiret2,
      lit_addsmtp TYPE STANDARD TABLE OF bapiadsmtp,
      lwa_addsmtp TYPE bapiadsmtp.
DATA:change_no LIKE rc29k-aennr.
DATA:final_app TYPE vbak-agrzr OCCURS 0.
DATA:wa_final_app TYPE vbak-agrzr.
DATA wf_initiator TYPE wfsyst-initiator.
DATA:
  matnr   TYPE mast-matnr.
DATA:  wa_mast TYPE mast.
DATA alt_bom TYPE rc29k-stlal.
DATA plant TYPE mast-werks.
DATA bomusage TYPE mast-stlan.
DATA ls_STKO TYPE stko_api01.
DATA valid_from TYPE csap_mbom-datuv.
DATA tcode TYPE sy-tcode.


swc_get_element container 'CHANGE_NO' change_no.
swc_get_element container 'WF_INIT' wf_initiator.
swc_get_element container 'MATNR' matnr.
swc_get_element container 'PLANT' plant.
swc_get_element container 'ALT_BOM' alt_bom.
swc_get_element container 'BOMUSAGE' bomusage.
swc_get_element container 'TCODE' tcode.

*DATA : a,b.
*a = 'X'.
*DO .
*  IF b = a.
*    EXIT.
*  ENDIF.
*ENDDO.
SELECT * FROM zbom_user INTO TABLE itab WHERE required = 'X'.
DESCRIBE TABLE itab LINES DATA(lv_count).
wa_final_app = lv_count.
APPEND wa_final_app TO final_app.

w_user = wf_initiator+2(12).

CALL FUNCTION 'BAPI_USER_GET_DETAIL'
  EXPORTING
    username = w_user
  TABLES
    return   = lit_return
    addsmtp  = lit_addsmtp.
READ TABLE lit_addsmtp INTO lwa_addsmtp INDEX 1.
IF lwa_addsmtp-e_mail IS NOT INITIAL.
  MOVE lwa_addsmtp-e_mail TO email_init.
ENDIF.


if tcode = 'CS02'.
SELECT SINGLE * FROM mast INTO wa_mast
   WHERE matnr = matnr
   AND werks = plant
   AND stlal = alt_bom
   AND stlan = bomusage.
IF sy-subrc = 0.
  SELECT SINGLE * FROM stko INTO @DATA(wa_stko)
    WHERE stlnr = @wa_mast-stlnr
    AND stlal = @alt_bom.
ENDIF.
ls_STKO-bom_status = '02'.
ls_STKO-base_quan = wa_stko-bmeng.
REPLACE ALL OCCURRENCES OF '.' IN ls_STKO-base_quan WITH ','.
valid_from = |{ sy-datum DATE = USER }|.
CALL FUNCTION 'CSAP_MAT_BOM_MAINTAIN'
  EXPORTING
    material           = wa_mast-matnr
    plant              = wa_mast-werks
    bom_usage          = wa_mast-stlan
    alternative        = wa_mast-stlal
    valid_from         = valid_from
    change_no          = change_no
    i_stko             = ls_STKO
    fl_commit_and_wait = 'X'
    fl_default_values  = 'X'
  EXCEPTIONS
    error              = 1
    OTHERS             = 2.
IF sy-subrc <> 0.
* Implement suitable error handling here
ENDIF.
ENDIF.

swc_set_element container 'EMAIL_INIT' email_init.
swc_set_table container 'FINAL_APPROVAL' final_app.
end_method.

