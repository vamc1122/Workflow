begin_method get_level_data changing container.
DATA:
  lv_counter TYPE vbak-agrzr,
  agent_id   TYPE soxna-fullname,
  agent      TYPE wfsyst-agent,
  ls_appr    LIKE swhactor,
  change_no  TYPE rc29k-aennr,
  wa_log     TYPE zpp_bom_wf_log,
  curr_level TYPE zpp_bom_wf_log-app_lvl,
  it_log     TYPE TABLE OF zpp_bom_wf_log.
swc_get_element container 'LV_COUNTER' lv_counter.
swc_get_element container 'CHANGE_NO' change_no.
*DATA : a,b.
*a = 'X'.
*DO .
*if b = a.
*  exit.
*ENDIF.
*ENDDO.
IF lv_counter IS INITIAL.
  lv_counter = '01'.
ENDIF.
CLEAR :ls_appr,agent_id,agent.
SELECT * FROM zbom_user INTO TABLE @DATA(itab) WHERE required = 'X'.
SORT itab BY zlevel.
DATA lv_count TYPE sy-index.
CLEAR lv_count.
lv_count = lv_counter.
READ TABLE itab INTO DATA(wtab) INDEX lv_count.

CONCATENATE 'US' wtab-zuser INTO agent.
MOVE wtab-zemail_id TO agent_id.
curr_level = lv_count.
wa_log-mandt = sy-mandt.
wa_log-aennr = change_no.
wa_log-app_lvl = wtab-zlevel.
wa_log-usrid   = wtab-zuser.
wa_log-stats   = 'P'.
wa_log-erdat   = sy-datum.
wa_log-erzet   = sy-uzeit.
wa_log-remrk   = 'Sent for Level 1 Approval'.
APPEND wa_log TO it_log.

MODIFY zpp_bom_wf_log FROM TABLE it_log.

swc_set_element container 'AGENT_ID' agent_id.
swc_set_element container 'AGENT' agent.
swc_set_element container 'CURR_LEVEL' curr_level.
swc_set_element container 'LV_COUNTER' lv_counter.

CLEAR :wtab,itab,wa_log,it_log.

end_method.

begin_method approved changing container.
DATA:
  curr_level TYPE zpp_bom_wf_log-app_lvl,
  change_no  LIKE rc29k-aennr.
swc_get_element container 'curr_level' curr_level.
swc_get_element container 'CHANGE_NO' change_no.


SELECT SINGLE * FROM zpp_bom_wf_log INTO  @DATA(wab)
  WHERE app_lvl = @curr_level AND aennr = @change_no.

wab-mandt = sy-mandt.
wab-stats   = 'A'.
wab-erdat   = sy-datum.
wab-erzet   = sy-uzeit.
wab-remrk   = |level { curr_level } Approved |.

MODIFY zpp_bom_wf_log FROM wab.
CLEAR wab.
end_method.
